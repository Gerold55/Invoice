{
  "name": "safari-invoice",
  "version": "1.0.0",
  "description": "Invoice maker for safari trips and lodging stays",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.safari.invoice",
    "productName": "Safari Invoice",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": { "target": ["portable", "nsis"] }
  }
}
